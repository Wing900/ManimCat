+    /// Encode the shown, finished take's final frame (the closing frame after `tear_down`)
+    /// at exactly `width` x `height`. The caller maps `buffer` and reads `pixels` bytes.
+    pub(crate) fn encode_image(&mut self, gpu: &mut Gpu, width: u32, height: u32) -> Result<ImageEncoding, String> {
+            // A completed take replaces the shown one; a failed one is dropped by `show`.
+            self.show(f64::INFINITY);
+            let Some(t) = self.shown.as_mut() else { return Err("the scene produced no take".into()) };
+            if !t.ended { return Err("the take has not ended".into()); }
+            if t.failed { return Err("the take ended after a scene failure".into()); }
+            if t.size != (width, height) {
+                return Err(format!("the take is {}x{}, not the requested {width}x{height}", t.size.0, t.size.1));
+            }
+            let Some(at) = t.shot(t.frame(f64::INFINITY)) else { return Err("the take has no recorded frames".into()); };
+            if (t.player.width, t.player.height) != (width, height) {
+                (t.player.width, t.player.height, t.player.targets) = (width, height, None);
+            }
+            let views = t.views(at)?;
+            let (mut encoder, _, composited) = t.player.encode(gpu, &views)?;
+            let padded = (width * 4).div_ceil(wgpu::COPY_BYTES_PER_ROW_ALIGNMENT) * wgpu::COPY_BYTES_PER_ROW_ALIGNMENT;
+            let pixels = padded as u64 * height as u64;
+            let buffer = gpu.device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("image readback"),
+                size: pixels + crate::render::COUNT_BYTES,
+                usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+                mapped_at_creation: false,
+            });
+            let targets = t.player.targets.as_ref().expect("targets");
+            encoder.copy_texture_to_buffer(
+                wgpu::TexelCopyTextureInfo { texture: targets.frame.color.texture(), mip_level: 0, origin: wgpu::Origin3d::ZERO, aspect: wgpu::TextureAspect::All },
+                wgpu::TexelCopyBufferInfo { buffer: &buffer, layout: wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(padded), rows_per_image: Some(height) } },
+                wgpu::Extent3d { width, height, depth_or_array_layers: 1 },
+            );
+            let capacity = if composited {
+                let lists = t.player.lists.as_ref().ok_or("the frame's see-through lists are missing")?;
+                encoder.copy_buffer_to_buffer(&lists.appended, 0, &buffer, pixels, Some(crate::render::COUNT_BYTES));
+                Some(lists.capacity)
+            } else {
+                None
+            };
+            Ok(ImageEncoding { encoder, buffer, pixels, padded, capacity })
+    }
