+    /// Encode the finished take's clean final frame (after `tear_down`) and return its
+    /// RGBA bytes at exactly `width` x `height`. The film texture is read back directly;
+    /// no player face, timeline, help overlay, letterbox or surface scaling is composited.
+    #[cfg(feature = "web")]
+    pub(crate) async fn render_image(&mut self, width: u32, height: u32) -> Result<Vec<u8>, String> {
+        use wasm_bindgen::JsValue;
+
+        for _ in 0..4 {
+            let (buffer, pixels, padded, capacity) = with_gpu(|gpu| -> Result<_, String> {
+                let encoded = self.takes.encode_image(gpu, width, height)?;
+                let (buffer, pixels, padded, capacity) = (encoded.buffer, encoded.pixels, encoded.padded, encoded.capacity);
+                gpu.queue.submit(Some(encoded.encoder.finish()));
+                Ok((buffer, pixels, padded, capacity))
+            })??;
+
+            let slice = buffer.slice(..pixels + crate::render::COUNT_BYTES);
+            let promise = js_sys::Promise::new(&mut |resolve, reject| {
+                slice.map_async(wgpu::MapMode::Read, move |result| match result {
+                    Ok(()) => {
+                        let _ = resolve.call0(&JsValue::UNDEFINED);
+                    }
+                    Err(error) => {
+                        let _ = reject.call1(&JsValue::UNDEFINED, &JsValue::from_str(&error.to_string()));
+                    }
+                });
+            });
+            wasm_bindgen_futures::JsFuture::from(promise)
+                .await
+                .map_err(|error| format!("the image readback failed: {error:?}"))?;
+
+            let mapped = buffer
+                .slice(..pixels + crate::render::COUNT_BYTES)
+                .get_mapped_range()
+                .map_err(|error| error.to_string())?;
+            let overflowed = capacity.is_some_and(|capacity| {
+                let appended = crate::render::count(&mapped[pixels as usize..]);
+                with_gpu(|gpu| {
+                    self.takes.shown.as_mut().is_some_and(|t| t.player.overflowed(gpu, appended, capacity))
+                })
+                .unwrap_or(false)
+            });
+            if overflowed {
+                drop(mapped);
+                buffer.unmap();
+                continue;
+            }
+
+            let row = (width * 4) as usize;
+            let mut output = Vec::with_capacity(row * height as usize);
+            for line in mapped[..pixels as usize].chunks_exact(padded as usize) {
+                output.extend_from_slice(&line[..row]);
+            }
+            drop(mapped);
+            buffer.unmap();
+            return Ok(output);
+        }
+        Err("the image frame still overflowed its see-through lists".into())
+    }
