# Browser-local renderer operator configuration (Vite build-time).
#
# The renderer must be served from a separate, secure origin from the main app.
# Local development may use a different localhost port; production requires HTTPS.
# Use the full internal route URL, not only the origin. The build emits the shared
# index.html; the renderer route is /renderer (the legacy browser-renderer.html name
# is normalized/redirected and never loads the main application).
#
# First-time visitors default to browser rendering. An empty value makes that mode
# unavailable; users must explicitly switch to cloud rendering to generate there.
#
# VITE_BROWSER_RENDERER_URL=http://localhost:5174/renderer
#
# Renderer deployment only (used by scripts/browser-rendering/build.mjs):
# permit embedding from this concrete main-app origin. No wildcard is accepted.
# BROWSER_RENDERER_MAIN_ORIGIN=http://localhost:5173
