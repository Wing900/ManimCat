# ManimCat production environment template

# Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
PROD_SUMMARY_LOG_ONLY=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Optional AI tuning
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=20000
# Total token limits include reasoning AND answer; effort is independent.
# Prefer high. Use max only on supported models; provider-default omits effort.
# AI_REASONING_EFFORT=high
# AI_PROVIDER_REQUEST_TIMEOUT_MS=600000
# DESIGNER_TEMPERATURE=0.8
# DESIGNER_MAX_TOKENS=20000
# DESIGNER_REASONING_EFFORT=high
# STUDIO_REASONING_EFFORT=high
# STUDIO_MAX_TOKENS=20000

# Optional media / retention
# MEDIA_RETENTION_HOURS=72
# MEDIA_CLEANUP_INTERVAL_MINUTES=60
# JOB_RESULT_RETENTION_HOURS=24

# Optional history persistence
# ENABLE_HISTORY_DB=true
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-key

# Optional Studio persistence
# ENABLE_STUDIO_DB=true

# Optional render-failure export
# ENABLE_RENDER_FAILURE_LOG=true
# ADMIN_EXPORT_TOKEN=replace_with_long_random_token
