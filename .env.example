# ManimCat local development environment template

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# PROD_SUMMARY_LOG_ONLY=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Studio event delivery across replicas (Redis Pub/Sub fan-out)
# redis = production default; memory = single-instance development only
STUDIO_EVENT_TRANSPORT=redis
# Deployments sharing one Redis must use different channels
# STUDIO_EVENT_REDIS_CHANNEL=manimcat:production:studio-events

# Studio Run coordination across replicas (session leases + durable cancellation markers)
# redis = production default; memory = single-instance development only
STUDIO_RUN_COORDINATION=redis
# Renewal must stay below half the lease TTL, otherwise a slow tick lets the lease lapse
# STUDIO_RUN_LEASE_TTL_MS=60000
# STUDIO_RUN_LEASE_RENEW_MS=15000
# Cancellation markers outlive a missed Pub/Sub notification for this long
# STUDIO_RUN_CANCEL_TTL_MS=3600000
# Deployments sharing one Redis must use different prefixes/channels
# STUDIO_RUN_REDIS_PREFIX=manimcat:production:studio-run
# STUDIO_RUN_CONTROL_CHANNEL=manimcat:production:studio-run-control

# Docker Compose host port binding
# One replica: keep stable access on 3000
MANIMCAT_PUBLISHED_PORT=3000
# Several replicas on one host: let Docker assign host ports
# (docker compose port manimcat 3000) and put a reverse proxy in front for real traffic
# MANIMCAT_PUBLISHED_PORT=0

# Recommended request-level AI tuning
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=12000
# AI_THINKING_TOKENS=20000
# DESIGNER_TEMPERATURE=0.8
# DESIGNER_MAX_TOKENS=12000
# DESIGNER_THINKING_TOKENS=20000
# CODE_GENERATION_TRANSPORT_ATTEMPTS=2
# PROBLEM_FRAMING_FORMAT_RETRIES=2
# OPENAI_STREAM_CONTENT_TIMEOUT_MS=240000
# Request token usage in the final streaming chunk. Set false only for incompatible providers.
# OPENAI_STREAM_INCLUDE_USAGE=true
# JOB_TRACKING_STALE_MS=60000

# Optional server behavior
# REQUEST_TIMEOUT=600000
# JOB_TIMEOUT=600000
# MANIM_TIMEOUT=600000
# CORS_ORIGIN=*

# Optional media storage paths
# VIDEO_OUTPUT_DIR=public/videos
# TEMP_DIR=temp

# Optional cleanup and retention
# MEDIA_RETENTION_HOURS=72
# MEDIA_CLEANUP_INTERVAL_MINUTES=60
# JOB_RESULT_RETENTION_HOURS=24

# Supabase (server-side only; the service role key must never reach the browser)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CatKey mode: the fixed server-side upstream used when a request authenticates with a CatKey.
# A browser that authenticates with a local BYOK config never touches these.
# CATKEY_UPSTREAM_URL=https://api.example.com/v1
# CATKEY_UPSTREAM_API_KEY=replace_with_upstream_key
# CATKEY_UPSTREAM_MODEL=deepseek-flash

# Optional Studio persistence
# Multi-replica Studio requires shared persistence (ENABLE_STUDIO_DB=true with Supabase).
# Studio scratch workspaces live in the system temp directory and hold one Session's Scene sources
# plus its in-flight renders. Nothing here is durable: the browser owns the copy.
# STUDIO_WORKSPACE_ROOT=/var/tmp/manimcat-studio
# STUDIO_WORKSPACE_TTL_HOURS=5
# STUDIO_WORKSPACE_CLEANUP_INTERVAL_MINUTES=30
# ENABLE_STUDIO_DB=true

# Optional render-failure export
# ENABLE_RENDER_FAILURE_LOG=true
# ADMIN_EXPORT_TOKEN=replace_with_long_random_token
