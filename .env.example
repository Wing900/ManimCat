# ManimCat local development environment template

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# PROD_SUMMARY_LOG_ONLY=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Studio event delivery across replicas (Redis Pub/Sub fan-out)
# redis = production default; memory = single-instance development only
STUDIO_EVENT_TRANSPORT=redis
# Deployments sharing one Redis must use different channels
# STUDIO_EVENT_REDIS_CHANNEL=manimcat:production:studio-events

# Docker Compose host port binding
# One replica: keep stable access on 3000
MANIMCAT_PUBLISHED_PORT=3000
# Several replicas on one host: let Docker assign host ports
# (docker compose port manimcat 3000) and put a reverse proxy in front for real traffic
# MANIMCAT_PUBLISHED_PORT=0

# Recommended server-side upstream routing
# One Bearer key mapped to one upstream profile.
MANIMCAT_ROUTE_KEYS=demo-key
MANIMCAT_ROUTE_API_URLS=https://api.example.com/v1
MANIMCAT_ROUTE_API_KEYS=sk-example
MANIMCAT_ROUTE_MODELS=gpt-4o-mini

# Optional request-level AI tuning
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=12000
# AI_THINKING_TOKENS=20000
# DESIGNER_TEMPERATURE=0.8
# DESIGNER_MAX_TOKENS=12000
# DESIGNER_THINKING_TOKENS=20000
# CODE_GENERATION_TRANSPORT_ATTEMPTS=2
# PROBLEM_FRAMING_FORMAT_RETRIES=2
# OPENAI_STREAM_CONTENT_TIMEOUT_MS=240000
# Request token usage in the final streaming chunk. Set false only for incompatible providers.
# OPENAI_STREAM_INCLUDE_USAGE=true
# JOB_TRACKING_STALE_MS=60000

# Optional server behavior
# REQUEST_TIMEOUT=600000
# JOB_TIMEOUT=600000
# MANIM_TIMEOUT=600000
# CORS_ORIGIN=*

# Optional media storage paths
# VIDEO_OUTPUT_DIR=public/videos
# TEMP_DIR=temp

# Optional cleanup and retention
# MEDIA_RETENTION_HOURS=72
# MEDIA_CLEANUP_INTERVAL_MINUTES=60
# JOB_RESULT_RETENTION_HOURS=24
# USAGE_RETENTION_DAYS=90
# METRICS_USAGE_RATE_LIMIT_MAX=30
# METRICS_USAGE_RATE_LIMIT_WINDOW_MS=60000

# Optional history persistence
# ENABLE_HISTORY_DB=true
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-key

# Optional Studio persistence
# Multi-replica Studio requires shared persistence (ENABLE_STUDIO_DB=true with Supabase).
# ENABLE_STUDIO_DB=true

# Optional render-failure export
# ENABLE_RENDER_FAILURE_LOG=true
# ADMIN_EXPORT_TOKEN=replace_with_long_random_token
